rules_version = '2';

// Firestore Database Rules
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow anyone (including guests) to read products, but only authenticated users to write
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow anyone (including guests) to read user profiles (necessary to show seller/vendor info on products),
    // but only authenticated users to write/update profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default rule: All other collections (bids, orders, notifications, messages, etc.) 
    // strictly require user authentication for both read and write
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
